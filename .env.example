# ==============================================================================
# SMART CART ETHIOPIA - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env locally or set these key-value pairs in your cloud dashboard.

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Neon / Supabase / PostgreSQL)
# ------------------------------------------------------------------------------
# Direct or pooled PostgreSQL connection string with SSL enabled for production
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/smart_cart?schema=public"

# ------------------------------------------------------------------------------
# 2. CORE API CONFIGURATION (apps/api - NestJS)
# ------------------------------------------------------------------------------
NODE_ENV="development"
PORT=3000

# Allowed origin(s) for CORS (comma-separated for multiple origins, e.g. https://smartcart.et,https://smartcart-web.vercel.app)
CORS_ORIGIN="http://localhost:3000,http://localhost:3001,http://localhost:8081"

# ------------------------------------------------------------------------------
# 3. REDIS CACHE (Upstash / Cloud Redis)
# ------------------------------------------------------------------------------
REDIS_URL="redis://localhost:6379"

# ------------------------------------------------------------------------------
# 4. TYPESENSE SEARCH ENGINE
# ------------------------------------------------------------------------------
TYPESENSE_API_KEY="xyz123typesenseapikey"
TYPESENSE_HOST="localhost"
TYPESENSE_PORT="8108"
TYPESENSE_PROTOCOL="http"

# ------------------------------------------------------------------------------
# 5. WEB FRONTEND CONFIGURATION (apps/web - Next.js)
# ------------------------------------------------------------------------------
# Production URL pointing to the deployed NestJS API (Vercel deployment)
NEXT_PUBLIC_API_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 6. MOBILE APP CONFIGURATION (apps/mobile - Expo)
# ------------------------------------------------------------------------------
# Production URL pointing to the deployed NestJS API (EAS / Expo client)
EXPO_PUBLIC_API_URL="http://localhost:3000"
